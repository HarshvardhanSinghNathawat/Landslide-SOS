# LandslideSOS API — Configuration
# Copy to .env and fill in real values

# ── Database ──────────────────────────────────────────
# SQLite (zero-install dev, default):
DATABASE_URL=sqlite:///./landslidesos.db
# Postgres+PostGIS (uncomment for production):
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/landslidesos

# ── Auth / JWT ────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── SMS Provider (Phase 3) ────────────────────────────
# mock | msg91 | fast2sms
SMS_PROVIDER=mock

# MSG91 (uncomment when using live SMS)
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=LSLSOS
# MSG91_TEMPLATE_ID=

# SMS rate limiting
SMS_MAX_PER_ZONE_PER_HOUR=3
SMS_RECIPIENT_LIMIT=200

# ── IMD Rainfall API (Phase 2a) ───────────────────────
# Requires a free account at api.imd.gov.in AND server IP whitelisting.
IMD_API_KEY=
IMD_API_BASE_URL=https://api.imd.gov.in

# ── DEM Download (Phase 2a) ───────────────────────────
# Optional; unauthenticated SRTM downloads are rate-limited. Get a key at
# https://opentopography.org (free academic).
OPENTOPOGRAPHY_API_KEY=

# ── Data pipeline ─────────────────────────────────────
# Where DEM tiles + inventory CSV live (default: backend/data/)
DATA_DIR=data/

# ── ML Model (Phase 2b) ───────────────────────────────
# Where model.joblib + risk_model.json are persisted
MODEL_DIR=models/
MODEL_PATH=models/risk_model.joblib
MODEL_VERSION=2026.09.15

# ── Celery scheduler (Phase 2b) ───────────────────────
# SQLite broker needs no Redis. Worker MUST run with --pool=solo on Windows.
#   celery -A app.tasks.celery_app worker --pool=solo -l info
#   celery -A app.tasks.celery_app beat -l info
CELERY_BROKER_URL=sqlalchemy+sqlite:///celery_broker.db
CELERY_RESULT_BACKEND=rpc://
CELERY_RECONCILE_MINUTES=30

# ── App ───────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]